#. The window's title.
#: src/main.c:20
msgid "Lantern"
msgstr "Lanterna"

#: src/help.c:7
msgid ""
"Lantern lights up your documents. Press the switch to turn a lamp on, and "
"press it again to turn it off.\n"
"Lamps stay lit until you close the window."
msgstr ""
"O Lantern ilumina seus documentos. Aperte o interruptor para acender uma "
"lâmpada e aperte de novo para apagá-la.\n"
"As lâmpadas ficam acesas até você fechar a janela."

#: src/main.c:58
#, c-format
msgid "%d lamp is lit"
msgid_plural "%d lamps are lit"
msgstr[0] "%d lâmpada acesa"
msgstr[1] "%d lâmpadas acesas"