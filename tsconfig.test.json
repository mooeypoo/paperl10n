{
  // Tests and test support. Vitest's types bring Node globals, so tests live in their own project.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "node_modules/.cache/tsbuild/test",
    "tsBuildInfoFile": "node_modules/.cache/tsbuild/test.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/domains/*/testing/**/*.ts",
    "src/domains/formats/plugin-api-testing.ts",
    "scripts/**/*.test.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/fixtures/**", "src/plugins/*/fixtures/**", "src/ui/**"],
  "references": [{ "path": "./tsconfig.core.json" }, { "path": "./tsconfig.node.json" }]
}
