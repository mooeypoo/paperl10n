{
  "name": "@paperl10n/desktop",
  "productName": "Paper Lion",
  "version": "0.0.0",
  "private": true,
  "description": "Side-by-side translation for Markdown docs sites and message catalogs, with first-class RTL support.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Moriel",
    "url": "https://moriel.tech"
  },
  "homepage": "https://github.com/mooeypoo/paperl10n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooeypoo/paperl10n.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#kernel/*": "./src/shared/kernel/*.ts",
    "#domains/*": "./src/domains/*/index.ts",
    "#domain-testing/*": "./src/domains/*/testing/index.ts",
    "#plugin-api": "./src/domains/formats/plugin-api.ts",
    "#plugin-api/testing": "./src/domains/formats/plugin-api-testing.ts",
    "#adapters/formats/*": "./src/domains/formats/adapters/*.ts",
    "#plugins/*": "./src/plugins/*/index.ts",
    "#adapters/workspace/*": "./src/domains/workspace/adapters/*.ts",
    "#adapters/document/*": "./src/domains/document/adapters/*.ts",
    "#ipc-contract": "./src/shared/ipc-contract/index.ts",
    "#app/*": "./src/app/*.ts",
    "#ui/mount": "./src/ui/mount.ts",
    "#assets/*": "./assets/*"
  },
  "scripts": {
    "dev": "node scripts/run-electron.ts electron-vite dev",
    "build": "electron-vite build && node scripts/check-app-build.ts",
    "dev:harness": "vite --config vite.harness.config.ts",
    "preview": "node scripts/run-electron.ts electron-vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "node scripts/check-spdx.ts && eslint . --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.{css,vue}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:fix": "node scripts/check-spdx.ts --fix && eslint . --cache --cache-location node_modules/.cache/eslint/ --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && node scripts/run-electron.ts playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@lezer/common": "1.5.3",
    "@lezer/markdown": "1.8.0",
    "banana-i18n": "^2.4.0",
    "vue": "^3.5.44"
  }
}
