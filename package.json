{
  "name": "@paperl10n/desktop",
  "productName": "Paper Lion",
  "version": "0.0.0",
  "private": true,
  "description": "Side-by-side translation for Markdown docs sites and message catalogs, with first-class RTL support.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Moriel",
    "url": "https://moriel.tech"
  },
  "homepage": "https://github.com/mooeypoo/paperl10n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooeypoo/paperl10n.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#kernel/*": "./src/shared/kernel/*.ts",
    "#domains/*": "./src/domains/*/index.ts",
    "#domain-testing/*": "./src/domains/*/testing/index.ts",
    "#plugin-api": "./src/domains/formats/plugin-api.ts",
    "#plugin-api/testing": "./src/domains/formats/plugin-api-testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "node scripts/check-spdx.ts && eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "node scripts/check-spdx.ts --fix && eslint . --cache --cache-location node_modules/.cache/eslint/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
